# ── Contoh konfigurasi environment untuk ImlaScan / Gramatical ──
# Salin file ini menjadi ".env" (tanpa .example), lalu isi nilainya.
# File .env TIDAK boleh di-commit (sudah diblokir .gitignore).

# Kunci rahasia Django. WAJIB diganti untuk produksi.
# Generate baru: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=ganti-dengan-secret-key-baru

# Mode debug. Set False saat deploy publik.
DJANGO_DEBUG=True

# Host yang diizinkan (pisah dengan koma), mis: example.com,www.example.com
DJANGO_ALLOWED_HOSTS=

# ── Model AraT5 (lokal) ──
IMLASCAN_MODEL_PATH=
IMLASCAN_TOKENIZER=UBC-NLP/AraT5v2-base-1024
IMLASCAN_PREFIX=
IMLASCAN_DEVICE=cuda
IMLASCAN_MAX_TOKENS=256
# Tagger jenis kesalahan: "areta" (layanan areta_service, fallback otomatis) | "heuristic"
IMLASCAN_TAGGER=areta

# ── OCR (PDF/gambar) ──
IMLASCAN_OCR_PROVIDER=gemini
IMLASCAN_OCR_DPI=200
IMLASCAN_GEMINI_KEY=
IMLASCAN_GEMINI_MODEL=gemini-flash-latest
IMLASCAN_GVISION_KEY=

# OCR pembanding (Tesseract lokal) — opsional, nilai di bawah = default
IMLASCAN_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
IMLASCAN_TESSDATA_DIR=
IMLASCAN_TESSERACT_LANG=ara
IMLASCAN_TESSERACT_PSM=6

# ── Pengaman & batas pemakaian (nilai di bawah = default) ──
# Wajib untuk deploy publik: DJANGO_DEBUG=False, DJANGO_SECRET_KEY baru, DJANGO_ALLOWED_HOSTS diisi.
# Di belakang nginx + HTTPS: IMLASCAN_BEHIND_PROXY=True dan DJANGO_CSRF_TRUSTED_ORIGINS=https://domain-anda
IMLASCAN_BEHIND_PROXY=False
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS=True
DJANGO_HSTS_SECONDS=0
DJANGO_ENABLE_ADMIN=False
IMLASCAN_MAX_UPLOAD_MB=10
IMLASCAN_MAX_PAGES=5
IMLASCAN_MAX_TEXT_CHARS=20000
# Pembatas laju per alamat IP, format "jumlah/detik". Kosongkan untuk mematikan.
IMLASCAN_RATE_LIMIT=30/600
IMLASCAN_RATE_LIMIT_OCR=10/600
IMLASCAN_GEMINI_TIMEOUT=100
IMLASCAN_GEMINI_TRIES=3
# Kuota GLOBAL Gemini OCR (semua pengunjung digabung), dalam halaman. 0 = tanpa batas.
# Saat habis, unggahan otomatis dibaca Tesseract dan pengguna diberi tahu.
IMLASCAN_GEMINI_DAILY_MAX=30
IMLASCAN_GEMINI_MONTHLY_MAX=0
IMLASCAN_KUOTA_UTC_OFFSET=7

# Batas waktu total OCR per unggahan (detik) dan batas ukuran piksel gambar
IMLASCAN_OCR_DEADLINE=150
IMLASCAN_MAX_MEGAPIXELS=40
# True di server: muat model saat server menyala (pengunjung pertama tidak menunggu)
IMLASCAN_PRELOAD=False
